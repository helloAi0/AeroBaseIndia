# Copy to .env.local (git-ignored) and edit.

# Backend base URL. Leave EMPTY for demo mode (no network calls, built-in demo data).
VITE_API_URL=http://localhost:8080

# Allow the built-in demo accounts to sign in when the backend is unreachable.
# Always on during `npm run dev`. Keep this "false" (or unset) for production builds.
VITE_ENABLE_DEMO_LOGIN=false
