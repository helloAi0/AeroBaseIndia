FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# Backend base URL baked in at build time, e.g. https://api.example.com  (demo logins stay OFF in production)
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL VITE_ENABLE_DEMO_LOGIN=false
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
