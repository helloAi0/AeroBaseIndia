# Set these in Vercel > Project > Settings > Environment Variables (never commit real values).
VITE_API_URL=https://aerobase-api.onrender.com
# Show the "Try a demo account" buttons on the sign-in page (they only pre-fill the form). Turn off for a real launch.
VITE_SHOW_DEMO_ACCOUNTS=true
VITE_DEMO_PASSWORD=the-same-value-as-DEMO_PASSWORD-on-Render
