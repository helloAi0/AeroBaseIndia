{
  "title": "AeroBase India",
  "panels": [
    {
      "title": "Total HTTP Requests",
      "type": "stat",
      "targets": [{"expr": "sum(aerobase_http_requests_total)"}]
    },
    {
      "title": "Requests per Second",
      "type": "graph",
      "targets": [{"expr": "rate(aerobase_http_requests_total[1m])"}]
    },
    {
      "title": "Active Requests",
      "type": "gauge",
      "targets": [{"expr": "aerobase_active_requests"}]
    },
    {
      "title": "P95 Latency (ms)",
      "type": "stat",
      "targets": [{"expr": "histogram_quantile(0.95, rate(aerobase_http_duration_ms_bucket[5m]))"}]
    },
    {
      "title": "P99 Latency (ms)",
      "type": "stat",
      "targets": [{"expr": "histogram_quantile(0.99, rate(aerobase_http_duration_ms_bucket[5m]))"}]
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "targets": [{"expr": "rate(aerobase_http_requests_total{status=\"500\"}[5m])"}]
    },
    {
      "title": "Requests by Path",
      "type": "bargauge",
      "targets": [{"expr": "sum by(path) (aerobase_http_requests_total)"}]
    }
  ],
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "10s"
}
