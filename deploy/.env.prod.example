# Copy to deploy/.env.prod and fill in. NEVER commit the filled-in file.
DB_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=            # openssl rand -hex 32
PUBLIC_API_URL=https://api.your-domain.example   # URL browsers use to reach the backend (baked into the frontend build)
# Optional notification channels (all off by default)
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TELEGRAM_BOT_TOKEN=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
