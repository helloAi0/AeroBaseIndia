	$(MAKE) $(MAKESILENT) -f CMakeFiles/AeroBaseIndia.dir/build.make CMakeFiles/AeroBaseIndia.dir/src/tracing/Tracer.cpp.o
.PHONY : src/tracing/Tracer.cpp.o

src/tracing/Tracer.i: src/tracing/Tracer.cpp.i
.PHONY : src/tracing/Tracer.i

# target to preprocess a source file
src/tracing/Tracer.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/AeroBaseIndia.dir/build.make CMakeFiles/AeroBaseIndia.dir/src/tracing/Tracer.cpp.i
.PHONY : src/tracing/Tracer.cpp.i

src/tracing/Tracer.s: src/tracing/Tracer.cpp.s
.PHONY : src/tracing/Tracer.s

# target to generate assembly for a file
src/tracing/Tracer.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/AeroBaseIndia.dir/build.make CMakeFiles/AeroBaseIndia.dir/src/tracing/Tracer.cpp.s
.PHONY : src/tracing/Tracer.cpp.s

